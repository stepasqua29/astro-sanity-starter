---
/* Componente standalone: niente framework, solo HTML+CSS+JS */
---
<style>
  .calculator{border:1px solid #e5e7eb;border-radius:16px;padding:16px;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.06);max-width:1100px;margin:0 auto}
  .grid{display:grid;gap:12px}
  .g3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .g2{grid-template-columns:repeat(2,minmax(0,1fr))}
  label{font-size:.9rem;font-weight:600}
  input,select{width:100%;border:1px solid #d1d5db;border-radius:10px;padding:10px 12px;font-size:.95rem;outline:none}
  input:focus,select:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
  .section{font-size:1.05rem;font-weight:700;margin:8px 0}
  .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
  .btn{border:none;border-radius:12px;padding:12px 16px;font-size:1rem;cursor:pointer}
  .primary{background:#111827;color:#fff}
  .secondary{background:#f3f4f6}
  .result{border-top:1px solid #eee;margin-top:16px;padding-top:16px;display:none}
  .small{font-size:.85rem;color:#6b7280}
  .badge{display:inline-block;font-size:.8rem;padding:4px 8px;border-radius:999px;background:#eef2ff;color:#3730a3}
</style>

<div class="calculator">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap">
    <h2 style="font-size:1.4rem;font-weight:800;margin:0">Calcolatore Valutazione Immobiliare</h2>
    <span class="badge">Stima istantanea (beta)</span>
  </div>

  <form id="valuation-form" novalidate>
    <div class="section">Dati immobile</div>
    <div class="grid g3">
      <div>
        <label>Paese</label>
        <select id="country" required>
          <option value="IT">Italia</option>
          <option value="FR">Francia</option>
          <option value="DE">Germania</option>
        </select>
      </div>
      <div>
        <label>Tipologia</label>
        <select id="type">
          <option>Appartamento</option>
          <option>Attico/Mansarda</option>
          <option>Villa/Porzione</option>
          <option>Rustico/Casale</option>
        </select>
      </div>
      <div>
        <label>Qualità zona (1-5)</label>
        <select id="areaQuality">
          <option value="3" selected>3 - media</option>
          <option value="1">1 - bassa</option>
          <option value="2">2 - medio-bassa</option>
          <option value="4">4 - medio-alta</option>
          <option value="5">5 - alta</option>
        </select>
      </div>

      <div>
        <label>Superficie (mq)</label>
        <input id="sqm" type="number" min="15" step="1" placeholder="Es. 85" required />
      </div>
      <div>
        <label>Camere</label>
        <input id="bed" type="number" min="0" step="1" placeholder="Es. 2" />
      </div>
      <div>
        <label>Bagni</label>
        <input id="bath" type="number" min="0" step="1" placeholder="Es. 1" />
      </div>

      <div>
        <label>Box/Posto auto (n.)</label>
        <input id="parking" type="number" min="0" step="1" placeholder="Es. 1" />
      </div>
      <div>
        <label>Piano</label>
        <input id="floor" type="number" min="-2" max="30" step="1" placeholder="T=0, 1, 2..." />
      </div>
      <div>
        <label>Ascensore</label>
        <select id="lift">
          <option value="yes">Sì</option>
          <option value="no">No</option>
        </select>
      </div>

      <div>
        <label>Stato immobile</label>
        <select id="houseState">
          <option value="nuovo">Nuovo / pari al nuovo</option>
          <option value="ristrutturato10" selected>Ristrutturato &lt; 10 anni</option>
          <option value="da_ristrutturare">Da ristrutturare</option>
        </select>
      </div>
      <div>
        <label>Classe energetica</label>
        <select id="energy">
          <option>A4</option><option>A3</option><option>A2</option><option>A1</option>
          <option>B</option><option selected>C</option><option>D</option>
          <option>E</option><option>F</option><option>G</option>
        </select>
      </div>
      <div>
        <label>Anno costruzione (opz.)</label>
        <input id="year" type="number" min="1900" max="2099" placeholder="Es. 1985" />
      </div>

      <div>
        <label>Balconi/Terrazzi (mq)</label>
        <input id="outdoor" type="number" min="0" step="1" placeholder="Es. 12" />
      </div>
      <div>
        <label>Giardino (mq)</label>
        <input id="garden" type="number" min="0" step="1" placeholder="Es. 50" />
      </div>
      <div>
        <label>Libero o locato</label>
        <select id="tenancy">
          <option value="libero" selected>Libero</option>
          <option value="locato">Locato</option>
        </select>
      </div>
    </div>

    <div class="section" style="margin-top:12px;">Indirizzo</div>
    <div class="grid g3">
      <div>
        <label>Via / Piazza</label>
        <input id="street" placeholder="Es. Via Garibaldi 12" />
      </div>
      <div>
        <label>Città</label>
        <input id="city" placeholder="Es. Torino" />
      </div>
      <div>
        <label>CAP / Codice postale</label>
        <input id="zip" placeholder="Es. 10121" />
      </div>
    </div>

    <div class="section" style="margin-top:12px;">I tuoi contatti</div>
    <div class="grid g3">
      <div>
        <label>Nome e Cognome</label>
        <input id="name" placeholder="Es. Mario Rossi" required />
      </div>
      <div>
        <label>Email</label>
        <input id="email" type="email" placeholder="esempio@mail.com" required />
      </div>
      <div>
        <label>Telefono</label>
        <input id="phone" type="tel" placeholder="+39 ..." />
      </div>
    </div>
    <div style="margin-top:8px">
      <label class="small"><input id="privacy" type="checkbox" /> Autorizzo il trattamento dei dati ai fini di ricontatto.</label>
    </div>

    <div class="actions">
      <button class="btn primary" id="btnCalc" type="submit">Calcola valutazione</button>
      <button class="btn secondary" id="btnReset" type="button">Reset</button>
    </div>
  </form>

  <div class="result" id="result">
    <div id="resultText"></div>
    <p class="small" style="margin-top:6px">
      * Stima automatica con margine ±10–15%. Per una valutazione professionale o una perizia giurata possiamo contattarti.
    </p>
  </div>
</div>

<script>
(function(){
  const $ = (id)=>document.getElementById(id);
  const fmt = (x)=>x.toLocaleString('it-IT',{style:'currency',currency:'EUR',maximumFractionDigits:0});

  function num(id, def=0){ const v = parseFloat($(id).value); return isNaN(v)?def:v; }

  function baseEurMq(country){
    if(country==='IT') return 1900;
    if(country==='FR') return 3500;
    if(country==='DE') return 3000;
    return 1900;
  }
  function areaAdj(q){ const t={1:0.85,2:0.93,3:1,4:1.08,5:1.15}; return t[parseInt(q,10)||3]||1; }
  function stateAdj(s){ return s==='nuovo'?1.12: s==='ristrutturato10'?1.05: s==='da_ristrutturare'?0.85:1; }
  function energyAdj(e){ const m={A4:1.08,A3:1.07,A2:1.06,A1:1.05,B:1.03,C:1,D:0.98,E:0.95,F:0.92,G:0.88}; return m[e]||1; }
  function typeAdj(t){ if(t.includes('Attico')) return 1.08; if(t.includes('Villa')) return 1.12; if(t.includes('Rustico')) return 0.9; return 1; }
  function floorAdj(f, lift){
    const n=parseInt(f,10); if(Number.isNaN(n)) return 1;
    if(n<=0) return 1;
    if(n<=2) return lift?1.02:0.98;
    if(n<=5) return lift?1.04:0.95;
    return lift?1.06:0.92;
  }
  function tenancyAdj(v){ return v==='locato'?0.95:1; }
  function outdoorVal(mq, base){ return Math.max(0,mq)*0.30*base; }   // 30% €/mq per terrazzi
  function gardenVal(mq, base){ return Math.max(0,mq)*0.15*base; }    // 15% €/mq per giardini
  function parkingVal(n){ return (parseInt(n,10)||0)*12000; }         // forfait per box/posto auto

  function compute(){
    const country = $('country').value;
    const type = $('type').value;
    const areaQ = $('areaQuality').value;
    const sqm = num('sqm');
    const bed = num('bed');
    const bath = num('bath');
    const parking = num('parking');
    const floor = $('floor').value;
    const lift = $('lift').value === 'yes';
    const houseState = $('houseState').value;
    const energy = $('energy').value;
    const outdoor = num('outdoor');
    const garden = num('garden');
    const tenancy = $('tenancy').value;

    if(!sqm || sqm<15) throw new Error('Inserisci una superficie valida (>=15 mq).');

    let eurmq = baseEurMq(country);
    eurmq *= areaAdj(areaQ);
    eurmq *= stateAdj(houseState);
    eurmq *= energyAdj(energy);
    eurmq *= typeAdj(type);
    eurmq *= floorAdj(floor, lift);
    eurmq *= tenancyAdj(tenancy);

    // piccole correzioni camere/bagni
    eurmq *= (1 + Math.min(0.12, Math.max(-0.06, (bed - 2) * 0.02)));
    eurmq *= (1 + Math.min(0.08, Math.max(-0.04, (bath - 1) * 0.03)));

    const core = eurmq * sqm;
    const plusOut = outdoorVal(outdoor, eurmq);
    const plusGarden = gardenVal(garden, eurmq);
    const plusPark = parkingVal(parking);
    const total = core + plusOut + plusGarden + plusPark;

    return {
      eurmq, total,
      low: total*0.88, high: total*1.12,
      plusOut, plusGarden, plusPark
    };
  }

  function payload(){
    const v = (id)=>$(id).value;
    return {
      immobile:{
        paese:v('country'), tipologia:v('type'), qualita_zona:v('areaQuality'),
        superficie_mq:v('sqm'), camere:v('bed'), bagni:v('bath'),
        box_posto_auto:v('parking'), piano:v('floor'), ascensore:v('lift'),
        stato:v('houseState'), classe_energetica:v('energy'), anno:v('year'),
        balconi_terrazzi_mq:v('outdoor'), giardino_mq:v('garden'), occupazione:v('tenancy'),
        indirizzo:{via:v('street'), citta:v('city'), cap:v('zip')}
      },
      contatti:{ nome:v('name'), email:v('email'), telefono:v('phone'),
        privacy: $('privacy').checked }
    };
  }

  document.addEventListener('DOMContentLoaded', ()=>{
    const form = $('valuation-form');
    const resBox = $('result');
    const resText = $('resultText');

    form.addEventListener('submit', (e)=>{
      e.preventDefault();
      const nameOk = $('name').value.trim().length>1;
      const emailOk = $('email').value.includes('@');
      if(!nameOk || !emailOk){ alert('Inserisci Nome ed Email validi.'); return; }

      try{
        const r = compute();
        resText.innerHTML = `
          <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
            <div><div class="small">Stima puntuale</div>
              <div style="font-size:1.6rem;font-weight:800">${fmt(r.total)}</div></div>
            <div><div class="small">Forchetta</div>
              <div style="font-size:1.1rem;font-weight:700">${fmt(r.low)} – ${fmt(r.high)}</div></div>
          </div>
          <div class="small" style="margin-top:8px">
            €/mq di riferimento: <strong>${fmt(r.eurmq)}</strong><br/>
            Extra esterni: ${fmt(r.plusOut)} · Giardino: ${fmt(r.plusGarden)} · Box/posti auto: ${fmt(r.plusPark)}
          </div>
          <div style="margin-top:10px">
            <a class="badge" id="mailtoLink" href="#">Invia richiesta di perizia dettagliata</a>
          </div>
        `;
        resBox.style.display = 'block';

        const subject = encodeURIComponent('Richiesta perizia dettagliata');
        const body = encodeURIComponent(JSON.stringify(payload(), null, 2));
        $('mailtoLink').setAttribute('href',
          `mailto:studioimmobiliareboldrini@gmail.com?subject=${subject}&body=${body}`);
      }catch(err){
        alert(err.message||'Errore di calcolo');
      }
    });

    $('btnReset').addEventListener('click', ()=>{
      form.reset();
      $('country').value='IT';
      $('type').value='Appartamento';
      $('areaQuality').value='3';
      $('lift').value='yes';
      $('houseState').value='ristrutturato10';
      $('energy').value='C';
      $('tenancy').value='libero';
      $('result').style.display='none';
    });
  });
})();
</script>
