<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Calcolatore Valutazione · Boldrini</title>
    <meta name="description" content="Calcolatore immobiliare realistico: quartiere (Torino), ascensore, piano, stato interno/parti comuni, esposizione, rumore, pertinenze." />
    <style>
      :root{--bg:#0b1220;--card:#0e1628;--ink:#eaf2ff;--muted:#9fb3d1;--brand:#6ee7ff;--brand-2:#7c3aed;--accent:#22c55e;--stroke:#1f2a44}
      *{box-sizing:border-box}
      body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink)}
      a{color:inherit;text-decoration:none}
      .wrap{max-width:1180px;margin:0 auto;padding:20px}
      header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0}
      nav a{opacity:.9;margin:0 10px}
      nav a:hover{opacity:1}
      .card{border:1px solid var(--stroke);border-radius:16px;background:#0b1324;padding:16px}
      .grid{display:grid;gap:12px}
      .g3{grid-template-columns:repeat(3,minmax(0,1fr))}
      label{font-size:.9rem;font-weight:600}
      input,select{width:100%;border:1px solid #263451;background:#0b1324;border-radius:10px;color:var(--ink);padding:10px 12px;outline:none}
      input:focus,select:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.15)}
      .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
      .btn{display:inline-block;border:none;border-radius:12px;padding:12px 16px;font-weight:700;cursor:pointer}
      .primary{background:#22c55e;color:#061016}
      .secondary{background:transparent;border:1px solid var(--stroke);color:var(--ink)}
      .result{border-top:1px solid var(--stroke);margin-top:16px;padding-top:16px;display:none}
      .small{font-size:.85rem;color:var(--muted)}
      .badge{display:inline-block;font-size:.8rem;padding:4px 8px;border-radius:999px;background:rgba(110,231,255,.12);color:#c9f6ff;border:1px solid rgba(110,231,255,.25)}
      h1{margin:8px 0 14px}
      @media(max-width:900px){.g3{grid-template-columns:1fr}}
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div><a href="/" style="font-weight:800">BOLDRINI</a></div>
        <nav>
          <a href="/">Home</a>
          <a href="/pacchetti">Pacchetti</a>
        </nav>
      </header>

      <h1>Calcolatore di valutazione</h1>
      <p class="small" style="margin-top:-6px">Usa quartiere + fattori reali. I valori di quartiere sono prudenziali.</p>

      <section class="card" id="calc-card">
        <form id="form" novalidate>
          <div class="grid g3">
            <div>
              <label>Paese</label>
              <select id="country"><option value="IT">Italia</option><option value="FR">Francia</option><option value="DE">Germania</option></select>
            </div>
            <div>
              <label>Città</label>
              <input id="city" placeholder="Es. Torino" value="Torino" />
            </div>
            <div>
              <label>Quartiere (se Torino)</label>
              <select id="district">
                <option value="">-- Seleziona --</option>
                <option>Centro</option><option>Crocetta</option><option>Cit Turin</option><option>San Salvario</option>
                <option>Vanchiglia</option><option>Santa Rita</option><option>Pozzo Strada</option><option>San Donato</option>
                <option>Lingotto</option><option>Borgo Vittoria</option><option>Aurora</option><option>Regio Parco</option>
                <option>Barriera di Milano</option><option>Mirafiori Nord</option><option>Mirafiori Sud</option>
              </select>
            </div>
            <div>
              <label>Qualità microzona (1-5)</label>
              <select id="areaQuality">
                <option value="3" selected>3 - media</option><option value="1">1 - bassa</option><option value="2">2 - medio-bassa</option>
                <option value="4">4 - medio-alta</option><option value="5">5 - alta</option>
              </select>
            </div>
            <div>
              <label>Indirizzo</label>
              <input id="street" placeholder="Es. Corso Giulio Cesare 100" />
            </div>
            <div>
              <label>CAP</label>
              <input id="zip" placeholder="Es. 10100" />
            </div>

            <div>
              <label>Tipologia</label>
              <select id="type"><option>Appartamento</option><option>Attico</option><option>Mansarda</option><option>Villa/Porzione</option><option>Rustico/Casale</option></select>
            </div>
            <div>
              <label>Superficie (mq)</label>
              <input id="sqm" type="number" min="15" step="1" placeholder="Es. 85" required />
            </div>
            <div>
              <label>Piano</label>
              <input id="floor" type="number" min="-2" max="30" step="1" placeholder="T=0, 1, 2..." />
            </div>
            <div>
              <label>Ascensore</label>
              <select id="lift"><option value="yes" selected>Sì</option><option value="no">No</option></select>
            </div>
            <div>
              <label>Camere</label>
              <input id="bed" type="number" min="0" step="1" placeholder="Es. 2" />
            </div>
            <div>
              <label>Bagni</label>
              <input id="bath" type="number" min="0" step="1" placeholder="Es. 1" />
            </div>
            <div>
              <label>Stato interno</label>
              <select id="houseState"><option value="nuovo">Nuovo / pari al nuovo</option><option value="ristrutturato10" selected>Ristrutturato &lt; 10 anni</option><option value="da_ristrutturare">Da ristrutturare</option></select>
            </div>
            <div>
              <label>Classe energetica</label>
              <select id="energy"><option>A4</option><option>A3</option><option>A2</option><option>A1</option><option>B</option><option selected>C</option><option>D</option><option>E</option><option>F</option><option>G</option></select>
            </div>
            <div>
              <label>Parti comuni</label>
              <select id="commonState"><option value="ottime">Ottime</option><option value="buone" selected>Buone</option><option value="scarse">Scarse</option></select>
            </div>
            <div>
              <label>Esposizione</label>
              <select id="exposure"><option value="mono">Mono</option><option value="doppia" selected>Doppia</option><option value="tripla">Tripla+</option></select>
            </div>
            <div>
              <label>Rumore/Traffico</label>
              <select id="noise"><option value="basso" selected>Basso</option><option value="medio">Medio</option><option value="alto">Alto (su corso)</option></select>
            </div>
            <div>
              <label>Riscaldamento</label>
              <select id="heating"><option value="autonomo" selected>Autonomo</option><option value="centralizzato">Centralizzato</option><option value="stufe">Stufe/altro</option></select>
            </div>
            <div><label>Balconi/Terrazzi (mq)</label><input id="outdoor" type="number" min="0" step="1" placeholder="Es. 12" /></div>
            <div><label>Giardino (mq)</label><input id="garden" type="number" min="0" step="1" placeholder="Es. 50" /></div>
            <div><label>Box/Posto auto (n.)</label><input id="parking" type="number" min="0" step="1" placeholder="Es. 1" /></div>
            <div>
              <label>Occupazione</label>
              <select id="tenancy"><option value="libero" selected>Libero</option><option value="locato">Locato</option></select>
            </div>
          </div>

          <div class="row" style="margin-top:12px">
            <button class="btn primary" id="btnCalc" type="submit">Calcola valutazione</button>
            <button class="btn secondary" id="btnReset" type="button">Reset</button>
          </div>
        </form>

        <div class="result" id="result">
          <div id="resultText"></div>
          <p class="small" style="margin-top:6px">* Stima automatica con margine ±10–15%. I valori di quartiere sono prudenziali e inclusi.</p>
        </div>
      </section>
    </div>

    <script>
      (function(){
        const $=(id)=>document.getElementById(id);
        const fmt=(x)=>x.toLocaleString('it-IT',{style:'currency',currency:'EUR',maximumFractionDigits:0});
        const num=(id,def=0)=>{const el=$(id);const v=parseFloat(el?el.value:"");return isNaN(v)?def:v};

        const TO_DISTRICT={ 'Centro':4000,'Crocetta':3300,'Cit Turin':3000,'San Salvario':2600,'Vanchiglia':2600,'Santa Rita':2100,'Pozzo Strada':2000,'San Donato':1900,'Lingotto':2000,'Borgo Vittoria':1800,'Aurora':1400,'Regio Parco':1500,'Barriera di Milano':1300,'Mirafiori Nord':1900,'Mirafiori Sud':1700 };

        function baseEurMq(country, city, district, areaQ){
          let base=1900; if(country==='FR')base=3500; if(country==='DE')base=3000;
          if((city||'').trim().toLowerCase()==='torino' && TO_DISTRICT[district]) base=TO_DISTRICT[district];
          const q=parseInt(areaQ,10)||3; const k={1:0.85,2:0.93,3:1.00,4:1.08,5:1.18}[q]||1;
          return base*k;
        }
        function typeAdj(t){ if(t==='Attico')return 1.10; if(t==='Mansarda')return 0.88; if(t.includes('Villa'))return 1.12; if(t.includes('Rustico'))return 0.90; return 1; }
        function stateAdj(s){ if(s==='nuovo')return 1.15; if(s==='ristrutturato10')return 1.06; if(s==='da_ristrutturare')return 0.82; return 1; }
        function energyAdj(e){ const m={A4:1.08,A3:1.06,A2:1.04,A1:1.03,B:1.02,C:1,D:0.97,E:0.93,F:0.90,G:0.86}; return m[e]||1; }
        function commonAdj(v){ if(v==='ottime')return 1.03; if(v==='buone')return 1.00; if(v==='scarse')return 0.96; return 1; }
        function exposureAdj(v){ if(v==='mono')return 0.97; if(v==='doppia')return 1.00; if(v==='tripla')return 1.02; return 1; }
        function noiseAdj(v){ if(v==='alto')return 0.94; if(v==='medio')return 0.98; return 1; }
        function heatAdj(v){ if(v==='autonomo')return 1.02; if(v==='centralizzato')return 0.99; if(v==='stufe')return 0.95; return 1; }
        function floorAdj(f, lift){
          const n=parseInt(f,10); if(Number.isNaN(n))return 1;
          if(lift){ if(n<=0)return 0.98; if(n<=2)return 1.00; if(n<=4)return 1.03; if(n<=6)return 1.05; return 1.06; }
          if(n<=0)return 0.95; if(n===1)return 0.98; if(n===2)return 0.94; if(n===3)return 0.88; if(n===4)return 0.82; if(n===5)return 0.75; if(n===6)return 0.70; return 0.65;
        }
        function outdoorVal(mq, base){ return Math.max(0,mq)*0.28*base; }
        function gardenVal(mq, base){ return Math.max(0,mq)*0.15*base; }
        function parkingVal(n){ return (parseInt(n,10)||0)*12000; }

        function compute(){
          const country=$('country').value, city=$('city').value, district=$('district').value, areaQ=$('areaQuality').value;
          const sqm=num('sqm'); if(!sqm||sqm<15) throw new Error('Inserisci una superficie valida (>=15 mq).');
          const type=$('type').value, floor=$('floor').value, lift=$('lift').value==='yes';
          const bed=num('bed'), bath=num('bath'), houseState=$('houseState').value, energy=$('energy').value;
          const commonState=$('commonState').value, exposure=$('exposure').value, noise=$('noise').value, heating=$('heating').value;
          const outdoor=num('outdoor'), garden=num('garden'), parking=num('parking'), tenancy=$('tenancy').value;

          let eurmq=baseEurMq(country,city,district,areaQ);
          eurmq*=typeAdj(type)*stateAdj(houseState)*energyAdj(energy)*commonAdj(commonState)*exposureAdj(exposure)*noiseAdj(noise)*heatAdj(heating)*floorAdj(floor,lift);
          if(tenancy==='locato') eurmq*=0.95;
          eurmq*=(1+Math.min(0.12,Math.max(-0.06,(bed-2)*0.02)));
          eurmq*=(1+Math.min(0.08,Math.max(-0.04,(bath-1)*0.03)));

          const core=eurmq*sqm, plusOut=outdoorVal(outdoor,eurmq), plusGarden=gardenVal(garden,eurmq), plusPark=parkingVal(parking);
          const total=core+plusOut+plusGarden+plusPark;
          return { eurmq,total,low:total*0.88,high:total*1.12,plusOut,plusGarden,plusPark };
        }

        document.addEventListener('DOMContentLoaded', ()=>{
          const form=$('form'), res=$('result'), rt=$('resultText');
          form.addEventListener('submit',(e)=>{
            e.preventDefault();
            try{
              const r=compute();
              rt.innerHTML = `
                <div class="row" style="align-items:baseline">
                  <div><div class="small">Stima puntuale</div><div style="font-size:1.6rem;font-weight:800">${fmt(r.total)}</div></div>
                  <div><div class="small">Forchetta</div><div style="font-size:1.1rem;font-weight:700">${fmt(r.low)} – ${fmt(r.high)}</div></div>
                </div>
                <div class="small" style="margin-top:8px">
                  €/mq di riferimento: <strong>${fmt(r.eurmq)}</strong><br/>
                  Extra esterni: ${fmt(r.plusOut)} · Giardino: ${fmt(r.plusGarden)} · Box/posti auto: ${fmt(r.plusPark)}
                </div>`;
              res.style.display='block';
            }catch(err){ alert(err.message||'Errore'); }
          });
          $('btnReset').addEventListener('click',()=>{ form.reset(); $('city').value='Torino'; $('lift').value='yes'; $('areaQuality').value='3'; $('houseState').value='ristrutturato10'; $('energy').value='C'; $('commonState').value='buone'; $('exposure').value='doppia'; $('noise').value='basso'; $('heating').value='autonomo'; $('tenancy').value='libero'; $('result').style.display='none'; });
        });
      })();
    </script>
  </body>
</html>
