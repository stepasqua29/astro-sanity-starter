<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Valutazioni & Perizie | Boldrini</title>
    <meta name="description" content="Valutazioni immobiliari, report professionali e perizie: servizi chiari, tempi rapidi, risultati misurabili." />
    <style>
      :root{
        --bg:#0b1220;            /* blu-notte */
        --card:#0e1628;
        --ink:#eaf2ff;           /* testo chiaro */
        --muted:#9fb3d1;
        --brand:#6ee7ff;         /* ciano acceso */
        --brand-2:#7c3aed;       /* viola brillante */
        --accent:#22c55e;        /* verde CTA */
        --stroke:#1f2a44;
        --grad:linear-gradient(135deg,var(--brand) 0%, var(--brand-2) 100%);
      }
      *{box-sizing:border-box}
      body{margin:0; font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink)}
      a{color:inherit}
      .wrap{max-width:1180px; margin:0 auto; padding:20px}
      header{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 0}
      .logo{font-weight:800; letter-spacing:.5px}
      nav a{opacity:.9; text-decoration:none; margin:0 10px}
      nav a:hover{opacity:1}
      .btn{display:inline-block; border:none; border-radius:12px; padding:12px 18px; font-weight:700; cursor:pointer; text-decoration:none}
      .btn-primary{background:var(--accent); color:#041410}
      .btn-ghost{border:1px solid var(--stroke); background:transparent}
      .hero{
        margin-top:18px; padding:40px; border:1px solid var(--stroke); border-radius:20px;
        background: radial-gradient(1200px 600px at 10% -10%, rgba(108,83,255,.25), transparent 60%),
                    radial-gradient(1200px 600px at 90% -10%, rgba(110,231,255,.20), transparent 60%),
                    var(--card);
      }
      .hero h1{font-size:clamp(28px,4.5vw,52px); line-height:1.12; margin:0 0 12px}
      .hero p{color:var(--muted); font-size:clamp(16px,2.2vw,18px); margin:0 0 22px}
      .kpis{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:16px}
      .kpis .k{border:1px solid var(--stroke); border-radius:14px; padding:14px; background:#0b1324; text-align:center}
      .section{margin-top:32px}
      .grid-3{display:grid; gap:14px; grid-template-columns:repeat(3,minmax(0,1fr))}
      .card{border:1px solid var(--stroke); border-radius:16px; background:#0b1324; padding:16px}
      .card h3{margin:0 0 8px}
      .tag{display:inline-block; font-size:.75rem; padding:4px 10px; border-radius:999px; background:rgba(110,231,255,.12); color:#c9f6ff; border:1px solid rgba(110,231,255,.25)}
      .list{color:var(--muted); margin:8px 0 0 16px}
      .cta-bar{display:flex; gap:10px; flex-wrap:wrap; align-items:center}
      .cta-gradient{background:var(--grad); color:#061016}
      .foot{margin-top:40px; padding:16px; text-align:center; color:#9fb3d1; border-top:1px solid var(--stroke)}
      .notice{font-size:.85rem; color:#96a9c6}
      @media (max-width:900px){
        .grid-3{grid-template-columns:1fr}
        .kpis{grid-template-columns:1fr}
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="logo">BOLDRINI • Valutazioni & Perizie</div>
        <nav>
          <a href="/">Home</a>
          <a href="/pacchetti">Pacchetti</a>
          <a href="#servizi">Servizi</a>
        </nav>
      </header>

      <!-- HERO -->
      <section class="hero">
        <h1>Valutazioni che ti fanno <span style="background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent">vendere</span>.</h1>
        <p>Stime realistiche (non numeri gonfiati), report comparativi pronti per trattare, e perizie professionali quando serve il timbro.</p>
        <div class="cta-bar">
          <a class="btn cta-gradient" href="/pacchetti">Scopri i pacchetti</a>
          <a class="btn btn-ghost" href="#servizi">Come lavoriamo</a>
        </div>
        <div class="kpis">
          <div class="k"><div style="font-weight:800; font-size:22px">48h</div><div class="notice">Report dettagliato medio</div></div>
          <div class="k"><div style="font-weight:800; font-size:22px">+12–18%</div><div class="notice">Prezzo spuntato vs stime “di pancia”*</div></div>
          <div class="k"><div style="font-weight:800; font-size:22px">7000€</div><div class="notice">Target consulenze settimana</div></div>
        </div>
        <div class="notice" style="margin-top:8px">*quando si usano comparabili seri + correzioni microzona, ascensore, piano, stato parti comuni.</div>
      </section>

      <!-- SERVIZI -->
      <section id="servizi" class="section">
        <h2 style="margin:0 0 10px">Servizi</h2>
        <div class="grid-3">
          <div class="card">
            <span class="tag">Gratuito</span>
            <h3>Stima Rapida</h3>
            <p class="notice">Calcolatore con fattori reali (quartieri Torino, ascensore/piano, stato, esposizione, rumore).</p>
            <ul class="list">
              <li>Valore + forchetta</li>
              <li>€/mq prudenziali per quartiere</li>
              <li>Pronto in 2 minuti</li>
            </ul>
            <div style="margin-top:10px">
              <a class="btn btn-primary" href="/pacchetti">Usa il calcolatore</a>
            </div>
          </div>

          <div class="card">
            <span class="tag">Più venduto</span>
            <h3>Report Dettagliato</h3>
            <p class="notice">PDF professionale con comparabili, foto, OMI, punteggi qualitativi e motivazioni del valore.</p>
            <ul class="list">
              <li>3–5 comparabili selezionati</li>
              <li>Metodologia trasparente</li>
              <li>Consegna entro 48h</li>
            </ul>
            <div style="margin-top:10px">
              <a class="btn cta-gradient" href="/pacchetti">Scopri prezzi</a>
            </div>
          </div>

          <div class="card">
            <span class="tag">Su preventivo</span>
            <h3>Perizia Professionale</h3>
            <p class="notice">Per banca/CTU/legale. Sopralluogo, rilievi, documenti e firma digitale.</p>
            <ul class="list">
              <li>Metodi: comparativo, costi, reddito</li>
              <li>Adatta a mutui, atti, contenziosi</li>
              <li>Firma digitale</li>
            </ul>
            <div style="margin-top:10px">
              <a class="btn btn-ghost" href="/pacchetti">Chiedi preventivo</a>
            </div>
          </div>
        </div>
      </section>

      <!-- PROVE SOCIALI / PERCHE' NOI -->
      <section class="section">
        <h2 style="margin:0 0 10px">Perché funziona</h2>
        <div class="grid-3">
          <div class="card">
            <h3>Comparabili veri</h3>
            <p class="notice">Non liste a caso: selezioniamo immobili venduti/non solo offerti, puliti per piano, ascensore, stato e microzona.</p>
          </div>
          <div class="card">
            <h3>Correzioni intelligenti</h3>
            <p class="notice">Ascensore/piano pesano davvero (soprattutto dal 3° in su). Mansarda ≠ Attico. Parti comuni e rumore incidono.</p>
          </div>
          <div class="card">
            <h3>Obiettivo: vendere</h3>
            <p class="notice">Valore credibile per trattare, non vetrina. Lavoriamo su margine di negoziazione realistico.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="section" style="border:1px solid var(--stroke); border-radius:16px; padding:18px; background:#0c1426">
        <div style="display:flex; gap:14px; align-items:center; justify-content:space-between; flex-wrap:wrap">
          <div>
            <div style="font-weight:800; font-size:22px; background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent">Pronto a iniziare?</div>
            <div class="notice">Scegli il pacchetto e invia i dati: ti rispondiamo in poche ore.</div>
          </div>
          <div>
            <a class="btn cta-gradient" href="/pacchetti">Vai ai pacchetti</a>
          </div>
        </div>
      </section>

      <footer class="foot">
        © Boldrini • Valutazioni & Perizie – P.IVA 12719230018 • <span class="notice">GDPR ready</span>
      </footer>
    </div>
  </body>
</html>
